APP_NAME="Sistem Informasi Arsip Kantah BPN Sumbawa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
APP_URL=https://arsip.bpn-sumbawa.lan

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arsip_bpn
DB_USERNAME=bpn_arsip_user
DB_PASSWORD=change_this_to_a_strong_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="arsip@bpn-sumbawa.go.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Akun Super Admin Pertama Saat Migrasi/Seeder
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=change_this_to_a_strong_initial_password

# Database Legacy (hanya dibutuhkan saat proses migrasi awal data CI3)
DB_LEGACY_HOST=127.0.0.1
DB_LEGACY_PORT=3306
DB_LEGACY_DATABASE=arsip_audit
DB_LEGACY_USERNAME=root
DB_LEGACY_PASSWORD=
